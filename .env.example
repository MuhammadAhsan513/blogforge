# Copy this file to `.env` and fill in the key(s) for the provider(s) you
# want available as a *server/development* fallback. These are optional:
# the Streamlit sidebar always lets a user paste their own key for the
# provider they select, and that session key takes priority over these
# env vars.
#
# You only need to set the key for the provider(s) you plan to use.

# Anthropic — https://console.anthropic.com/settings/keys (paid)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI — https://platform.openai.com/api-keys (paid)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Groq — https://console.groq.com/keys (free tier)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
